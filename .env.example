# Declan 2.0 standalone backend environment template
# Copy to a protected environment file. Never commit the populated file.
# The actual backend may support additional settings; see docs/environment.md.

# Required for the Home Assistant Ingress proxy when enabled.
DECLAN_INGRESS_TOKEN=replace-with-a-long-random-secret

# Optional VoicePipeline management connection.
# Set to your own service endpoint, not a publicly accessible address.
DECLAN_VOICEPIPELINE_URL=http://127.0.0.1:8000
DECLAN_VOICEPIPELINE_TOKEN=

# Do not put OpenAI or Spotify secrets in this example. Configure those
# through Declan's authenticated settings where supported.
