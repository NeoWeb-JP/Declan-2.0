# Declan 2.0 standalone backend environment template
# Copy to a protected environment file. Never commit the populated file.
# The actual backend may support additional settings; see docs/environment.md.

# Home Assistant API connection (required for backend HA operations).
DECLAN_HA_URL=http://homeassistant.local:8123
DECLAN_HA_TOKEN=replace-with-a-home-assistant-long-lived-token

# Assist bridge token must be separate from the Ingress token.
DECLAN_ASSIST_TOKEN=replace-with-a-separate-random-secret-at-least-32-chars

# Required for the Home Assistant Ingress proxy when enabled.
DECLAN_INGRESS_TOKEN=replace-with-a-long-random-secret

# Optional server binding; omit to use the backend default.
# DECLAN_BIND_ADDRESS=127.0.0.1

# Optional explicit release version override; normally leave unset.
# DECLAN_RELEASE_VERSION=

# Local voice encryption is separate from VoicePipeline storage. Release activation
# requires a valid key; there is no generated default. Provision it securely,
# outside .data, source control and upgrade backups. Never use this placeholder.
# See docs/local-voice-encryption.md for stopped-service legacy migration.
# DECLAN_VOICE_AUDIO_KEY=<provision-a-base64url-encoded-32-byte-key>

# Optional VoicePipeline management connection.
# Set to your own service endpoint, not a publicly accessible address.
DECLAN_VOICEPIPELINE_URL=http://127.0.0.1:8000
DECLAN_VOICEPIPELINE_TOKEN=

# Do not put OpenAI or Spotify secrets in this example. Configure those
# through Declan's authenticated settings where supported.
